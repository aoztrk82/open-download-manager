; ODM installer (Inno Setup 6). Built by scripts/build-installer.ps1, which
; passes /DAppVersion and expects dist\odm.exe and dist\ffmpeg\ to exist.
;
; Per-user install (no admin prompt): ODM registers everything per user anyway
; (native-messaging hosts, autostart, %APPDATA%\odm), and a download manager
; should not need elevation to update itself later.

#ifndef AppVersion
  #error Pass /DAppVersion=x.y.z (scripts/build-installer.ps1 does)
#endif
#define AppName "ODM"
#define AppFullName "ODM - Open Download Manager"

[Setup]
; Never change AppId: it is how upgrades and the uninstaller find an existing install.
AppId={{597B1982-7914-45E1-B811-08E80464ACBF}
AppName={#AppFullName}
AppVersion={#AppVersion}
AppVerName={#AppFullName} {#AppVersion}
AppPublisher=ODM
VersionInfoVersion={#AppVersion}
PrivilegesRequired=lowest
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
DisableDirPage=auto
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=..\dist
OutputBaseFilename=odm-setup-{#AppVersion}
SetupIconFile=..\cmd\odm\assets\odm.ico
UninstallDisplayIcon={app}\odm.exe
UninstallDisplayName={#AppFullName}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
; ODM is stopped with "odm quit" first (PrepareToInstall); the Restart Manager
; is only the fallback for anything else holding a file.
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "tr"; MessagesFile: "compiler:Languages\Turkish.isl"

[CustomMessages]
en.Autostart=Start ODM with Windows
tr.Autostart=ODM'yi Windows ile başlat
en.LaunchNow=Start ODM now
tr.LaunchNow=ODM'yi şimdi başlat
en.ExtraTasks=Additional options:
tr.ExtraTasks=Ek seçenekler:

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "autostart"; Description: "{cm:Autostart}"; GroupDescription: "{cm:ExtraTasks}"

[Files]
Source: "..\dist\odm.exe"; DestDir: "{app}"; Flags: ignoreversion
; Small LGPL remux-only ffmpeg (tools/ffmpeg/build.sh); ODM finds it next to odm.exe.
Source: "..\dist\ffmpeg\ffmpeg.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\dist\ffmpeg\ffmpeg-LICENSE.txt"; DestDir: "{app}\licenses"; Flags: ignoreversion
Source: "..\dist\ffmpeg\ffmpeg-README.txt"; DestDir: "{app}\licenses"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\odm.exe"; Comment: "{#AppFullName}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\odm.exe"; Tasks: desktopicon

[Registry]
; Same value the tray's "Start with Windows" item writes, so the two agree.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "ODM"; \
  ValueData: """{app}\odm.exe"" tray --background"; Tasks: autostart; Flags: uninsdeletevalue

[Run]
; The tray registers the browser native-messaging host and refreshes the
; Chrome extension folder on start, so launching it finishes the setup.
Filename: "{app}\odm.exe"; Description: "{cm:LaunchNow}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Generated by the tray; downloads, the database and settings stay.
Type: filesandordirs; Name: "{userappdata}\odm\native"
Type: filesandordirs; Name: "{userappdata}\odm\extension"

[Code]
procedure QuitODM(const Exe: String);
var
  Code: Integer;
begin
  { Clean exit: downloads are saved and resume after the update. }
  if FileExists(Exe) then
    Exec(Exe, 'quit --wait 20s', '', SW_HIDE, ewWaitUntilTerminated, Code);
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  QuitODM(ExpandConstant('{app}\odm.exe'));
  Result := '';
end;

function InitializeUninstall(): Boolean;
begin
  QuitODM(ExpandConstant('{app}\odm.exe'));
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    { Browser integration written by the tray (cmd/odm/native_windows.go). }
    RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Google\Chrome\NativeMessagingHosts\odm_host');
    RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Microsoft\Edge\NativeMessagingHosts\odm_host');
    RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Mozilla\NativeMessagingHosts\odm_host');
    { The tray menu may have written autostart even if the task was not chosen. }
    RegDeleteValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Run', 'ODM');
  end;
end;
