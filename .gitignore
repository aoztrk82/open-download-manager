# Build output
/odm.exe
/odm
/dist/
extension/dist/
# Copied in by `pnpm build`; the signed xpi next to it is committed on purpose
/internal/extbundle/files/chrome/
*.exe
# go build renames a running odm.exe out of the way
*.exe~
*.test
*.out

# Downloads in progress / test artifacts
*.part
/tmp/
/testdata/downloads/

# Local databases and per-user state (the daemon keeps these in %APPDATA%\odm, not the repo)
*.db
*.db-wal
*.db-shm

# Secrets (AMO signing keys etc.)
.env
.env.*

# Node
node_modules/
extension/*.log
.pnpm-store/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code: personal settings stay local, shared skills are committed
.claude/settings.local.json
.claude/scratch/
